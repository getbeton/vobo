POSTGRES_URL=postgres://localhost:5432/vobo_dev
AUTH_SECRET=...
BETTER_AUTH_URL=http://localhost:3000
# S3 (optional; falls back to .storage/ fs driver)
#STORAGE_S3_BUCKET=
#STORAGE_S3_ENDPOINT=
#STORAGE_S3_REGION=
#STORAGE_S3_PREFIX=vobo
#STORAGE_S3_ACCESS_KEY_ID=
#STORAGE_S3_SECRET_ACCESS_KEY=
# Product analytics (optional). Unset = no telemetry leaves the deployment.
# Server events need POSTHOG_KEY. The public key is browser-only and is inlined
# at build time. Do not copy the public key into POSTHOG_KEY on a self-host
# unless you want that install to phone home.
#POSTHOG_KEY=
#POSTHOG_HOST=https://us.i.posthog.com
#NEXT_PUBLIC_POSTHOG_KEY=
#NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Entity-page display only (optional)
#VOBO_PLAN_TIER=Self-hosted
#VOBO_PLAN_CAP=
#VOBO_COST_PER_ROUND=
# Transactional email (magic links + verification). Unset = links are logged to
# the server console instead of delivered, which is fine for local dev only.
#RESEND_API_KEY=
#EMAIL_FROM=Vobo <noreply@getbeton.ai>
